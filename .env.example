# ===== ME-AITA 教师成长智能体 配置示例 =====
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# 智谱 API Key（在 https://open.bigmodel.cn/ 的 API Keys 页面创建）
ZHIPU_API_KEY=your_zhipu_api_key_here

# 使用的模型（可选，默认 glm-4-flash）
# 可用模型参考：glm-4-flash（免费）、glm-4-flash-250414、glm-4-air、glm-4-air-250414、glm-4-plus、glm-4.7
ZHIPU_MODEL=glm-4-flash
